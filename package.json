{
  "name": "hermsdeskapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "shortcut": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/create-shortcut.ps1",
    "setup:jan": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/setup-bundled-jan.ps1"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/win-unpacked/**",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/jan-runtime/app",
        "to": "bin/jan-runtime/app",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.11",
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "form-data": "^4.0.5",
    "lucide-react": "^0.378.0",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "systeminformation": "^5.31.5",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
